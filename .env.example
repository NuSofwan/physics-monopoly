# Local dev defaults below. In production (Vercel), set both to your deployed
# Render service, e.g. VITE_SERVER_URL=wss://<service>.onrender.com and
# VITE_API_URL=https://<service>.onrender.com in Project Settings > Environment
# Variables before build — Vite inlines these at build time, so they must be
# set there, not just here.
VITE_SERVER_URL=ws://localhost:2567
VITE_API_URL=http://localhost:2567
PORT=2567
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:2567
# Local only. Set explicitly in your shell; never enable demo teacher accounts in production.
DEV_TEACHER_AUTH=false
# DATABASE_URL is optional locally after npm run setup:local; credentials are generated in .local/.
# DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/physics_world
# Production: configure an OIDC provider, HTTPS origins and an exact subject allowlist.
# OIDC_ISSUER=https://school-identity.example
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# TEACHER_ALLOWED_SUBJECTS=subject-one,subject-two
# PRIVATE_STORAGE_PATH=C:/private/physics-uploads
OCR_MODE=local
